# Local Docker settings. Copy this file to .env and keep the replacement values private.
APP_ENV=development
# Fine for local testing. Use a unique secret before the first production start.
POSTGRES_PASSWORD=monarch-local-only
QUOTE_DRAFT_RETENTION_HOURS=24
QUOTE_ACCEPTED_RETENTION_DAYS=30
QUOTE_UNHANDLED_RETENTION_DAYS=90
QUOTE_CLEANUP_INTERVAL_SECONDS=60
NUXT_PUBLIC_SHOW_PORTFOLIO=false

# Telegram: first send /start to the bot, then discover the numeric chat id as described in README.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Protected admin inbox. Never commit real account values.
ADMIN_BASE_URL=https://admin.example.com
ADMIN_ALLOWED_EMAILS=["owner@example.com"]
CLOUDFLARE_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=
ADMIN_DEV_TOKEN=

# Optional. Only needed for: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
