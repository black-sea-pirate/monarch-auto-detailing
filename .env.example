# Local Docker settings. Copy this file to .env and keep the replacement values private.
APP_ENV=development
# Fine for local testing. Use a unique secret before the first production start.
POSTGRES_PASSWORD=monarch-local-only
QUOTE_RETENTION_HOURS=168
QUOTE_CLEANUP_INTERVAL_SECONDS=3600
NUXT_PUBLIC_SHOW_PORTFOLIO=false

# Telegram: first send /start to the bot, then discover the numeric chat id as described in README.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Optional. Only needed for: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
