[Unit]
Description=Deploy the latest tested Monarch production commit
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/monarch
ExecStart=/usr/local/sbin/monarch-deploy
TimeoutStartSec=20min

[Install]
WantedBy=multi-user.target
